[Unit]
Description=Secure Firewall shared read-only schema MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=secure-firewall-schema
Group=secure-firewall-schema
WorkingDirectory=/opt/secure-firewall-schema-service
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/secure-firewall-schema-service/.venv/bin/python -m secure_firewall_assistant.cli schema-serve --directory /var/lib/secure-firewall-schemas --host 0.0.0.0 --port 8765 --allowed-host 10.196.150.41:8765 --allowed-host 127.0.0.1:8765 --allowed-host localhost:8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
