{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "secure-firewall": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--python",
        "3.12",
        "${PLUGIN_ROOT}/scripts/runtime.py",
        "--source",
        "${PLUGIN_ROOT}"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
